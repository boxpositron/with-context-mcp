{
  "$schema": "https://raw.githubusercontent.com/boxpositron/with-context-mcp/main/src/config/config-schema.json",

  // Configuration generated based on repository analysis
  // Project: with-context-mcp
  // Type: mcp-server

  "version": "2.1",

  // Default behavior for files not matching any patterns
  "defaultBehavior": "local",

  // Patterns for files to delegate to Obsidian vault
  // Based on Diátaxis framework: guides, tutorials, reference, architecture
  "vault": [
    "CHANGELOG.md",
    "docs/INTELLIGENT_SETUP_GUIDE.md",
    "docs/CHANGELOG_TODO_GUIDE.md",
    "docs/guides/**/*.md",
    "docs/tutorials/**/*.md",
    "docs/architecture/**/*.md",
    "docs/research/**/*.md",
    "docs/api/**/*.md",
    // Test documentation
    "tests/integration/SESSION_WORKFLOW_TEST_SUMMARY.md",
    // Development docs
    "COMMAND_UPDATES.md",
    "PATH_RESOLUTION_FIX.md",
  ],

  // Patterns for files to keep in local repository
  // Essential files for repository operation and quick reference
  "local": [
    "README.md",
    "plugin/README.md",
    "src/session/README.md",
    "src/templates/README.md",
    "/README.md",
    "/CONTRIBUTING.md",
    "/LICENSE",
    "/AGENTS.md",
    "src/**/*.md",
    "examples/**/*.md",
    "dist/**",
    "node_modules/**",
    "build/**",
    "coverage/**",
    ".git/**",
    ".github/**",
    ".vscode/**",
    ".idea/**",
    "**/*.draft.md",
    "**/*.wip.md",
    ".env*",
    "*.config.*",
    "package.json",
    "tsconfig.json",
  ],

  // Conflict resolution strategy
  "conflictResolution": "local-wins",
}
