# WithContext Plugin Configuration
# Copy this file to .env and update with your settings

# Required: Path to your Obsidian vault
OBSIDIAN_VAULT_PATH="$HOME/Documents/Vault"

# Required: Obsidian Local REST API settings
OBSIDIAN_API_URL="https://127.0.0.1:27124"
OBSIDIAN_API_KEY="your-api-key-here"
OBSIDIAN_VAULT="YourVaultName"

# Optional: Base path for projects within vault (default: Projects)
PROJECT_BASE_PATH="Projects"

# Optional: Node environment (development allows self-signed certs)
NODE_ENV="development"
