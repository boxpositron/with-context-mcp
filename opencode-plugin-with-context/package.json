  "dependencies": {
    "@opencode-ai/plugin": "^1.0.15",
    "with-context-mcp": "file:../"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
