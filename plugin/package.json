{
  "name": "with-context-opencode-plugin",
  "version": "2.0.1",
  "description": "OpenCode plugin for with-context-mcp - project-scoped note management in Obsidian",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "opencode",
    "plugin",
    "notes",
    "obsidian",
    "markdown",
    "mcp"
  ],
  "author": "David Ibia <david.ibia@boxmarshall.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidibia/with-context-mcp.git",
    "directory": "plugin"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.15",
    "with-context-mcp": "file:../"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
