# .withcontextignore
#
# This file controls which documentation files are delegated to your Obsidian vault
# via the with-context MCP server.
#
# SYNTAX:
#   - One pattern per line
#   - Lines starting with # are comments
#   - Blank lines are ignored
#   - Use ! to negate a pattern (include files that would otherwise be ignored)
#   - Patterns use glob syntax (*, **, ?, [abc], etc.)
#   - Patterns starting with / match only at the project root
#   - Patterns ending with / match directories and all their contents
#
# HOW IT WORKS:
#   - Files matching patterns in this file will NOT be delegated to vault
#   - All other documentation files (.md, .txt, etc.) WILL be delegated
#   - Use this to keep certain docs local while delegating others

# -----------------------------------------------------------------------------
# PROJECT-SPECIFIC: TypeScript Library/MCP Server
# -----------------------------------------------------------------------------

# Keep main README local (repository documentation)
/README.md

# Keep development documentation local
/AGENTS.md
/CONTRIBUTING.md

# Keep plugin-specific documentation local (for development)
plugin/README.md
plugin/**/*.md

# Keep example files local (development reference)
examples/
**/examples/**

# Keep template documentation local
src/templates/README.md

# -----------------------------------------------------------------------------
# BUILD & TOOL OUTPUT
# -----------------------------------------------------------------------------

# Don't delegate build artifacts
dist/
build/
out/
coverage/
.nyc_output/

# Don't delegate TypeScript declarations
**/*.d.ts
**/*.d.ts.map

# -----------------------------------------------------------------------------
# SOURCE CODE & TESTS
# -----------------------------------------------------------------------------

# Keep source code documentation local
src/**/*.md

# Keep test documentation local
tests/**/*.md
test/**/*.md
__tests__/**/*.md

# -----------------------------------------------------------------------------
# VERSION CONTROL & IDE
# -----------------------------------------------------------------------------

# Don't delegate git-related docs
.git/
.github/**

# IDE-specific files
.vscode/
.idea/
.opencode/

# -----------------------------------------------------------------------------
# DEPENDENCIES
# -----------------------------------------------------------------------------

# Don't delegate node_modules documentation
node_modules/
vendor/

# -----------------------------------------------------------------------------
# CONFIGURATION FILES
# -----------------------------------------------------------------------------

# Keep config-related documentation local
.env*
*.config.js
*.config.ts
tsconfig.json
package.json
package-lock.json

# -----------------------------------------------------------------------------
# WORK IN PROGRESS
# -----------------------------------------------------------------------------

# Keep work-in-progress docs local
docs/wip/
docs/drafts/
**/*.draft.md
**/*.wip.md
**/*-draft.md

# -----------------------------------------------------------------------------
# SENSITIVE CONTENT
# -----------------------------------------------------------------------------

# Keep sensitive documentation local (never delegate)
docs/sensitive/
docs/credentials/
docs/secrets/
**/confidential/**

# -----------------------------------------------------------------------------
# PERSONAL NOTES
# -----------------------------------------------------------------------------

# Keep personal notes local
notes/
personal/
todo.md
scratch.md

# -----------------------------------------------------------------------------
# CUSTOM PATTERNS
# -----------------------------------------------------------------------------

# Keep LICENSE local (part of repository structure)
LICENSE

# Keep template file local
.withcontextignore.template

# Keep temporary directories local
opencodetmp/
tmp/
temp/
